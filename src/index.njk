---
layout: layouts/base.njk
title: "daily_digest.json — archive"
eleventyComputed:
  subtitle: "{{ site.tagline }}"
---

{% import "macros/ui.njk" as ui %}

{% set entryCount = digests | length %}

{% call ui.card() %}

  {{ ui.heading("archive", entryCount + " entries") }}

  <div class="grid gap-2">
    {% for digest in digests %}
    <a href="/digest/{{ digest.date }}/"
       class="flex items-center justify-between gap-4 rounded-lg border border-zinc-800 bg-zinc-900 px-4 py-4 transition-colors hover:border-teal-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-300">
      <span class="text-sm font-semibold">{{ digest.date | formatDate }}</span>
      <span class="text-teal-300">&rarr;</span>
    </a>
    {% endfor %}
  </div>

{% endcall %}
