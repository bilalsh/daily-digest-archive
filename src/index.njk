<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>daily_digest.json — archive</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <span class="grid-gutter left" aria-hidden="true"></span>
  <span class="grid-gutter right" aria-hidden="true"></span>

  <div class="container">

    <header class="masthead">
      <div class="badge"><span class="pulse"></span>live · updated daily</div>
      <h1>daily<span class="accent-char">_</span>digest.json</h1>
      <p class="tagline">Gold, currency, fuel, PSX and prayer times — one JSON file, rendered fresh every day.</p>
    </header>

    <main>
      <section class="digest-card">
        <div class="section-heading">
          <h2>archive</h2>
          <span class="section-meta">{{ digests | length }} entries</span>
        </div>

        <div class="archive-list">
          {% for digest in digests %}
            <a class="archive-card" href="/digest/{{ digest.date }}/">
              <span class="archive-date">{{ digest.date | formatDate }}</span>
              <span class="archive-arrow">→</span>
            </a>
          {% endfor %}
        </div>
      </section>
    </main>

    <footer>
      built with eleventy · deployed on cloudflare pages · <a href="https://github.com/bilalsh/daily-digest-archive">view source →</a>
    </footer>

  </div>

</body>
</html>
