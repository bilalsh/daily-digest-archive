---
pagination:
  data: digests
  size: 1
  alias: digest
permalink: "digest/{{ digest.date }}/index.html"
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>Daily Digest — {{ digest.date | formatDate }}</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <div class="container">

    <header class="digest-header">
      <a class="back-link" href="/">← Back to archive</a>

      <h1>Daily Digest</h1>
      <p class="digest-date">{{ digest.date | formatDate }}</p>
    </header>

    <main>

    {% if digest.weather %}
    <section class="digest-card weather-card">
      <div class="section-heading">
        <h2>Weather</h2>
      </div>

      <div class="weather-main">
        <div class="weather-temperature">
          {{ digest.weather.temperature_min }}° → {{ digest.weather.temperature_max }}°
        </div>

        <div class="weather-condition">
          <strong>{{ digest.weather.summary }}</strong>
          <span>Feels like up to {{ digest.weather.apparent_temperature_max }}°C</span>
        </div>
      </div>

      <div class="weather-details">
        {% if digest.weather.significant_weather %}
        <div>
          <span class="detail-label">
            {{ digest.weather.significant_weather.type | capitalize }}
          </span>
          <strong>
            {{ digest.weather.significant_weather.period | capitalize }}
            {{ digest.weather.significant_weather.probability }}%
          </strong>
        </div>
        {% endif %}

        <div>
          <span class="detail-label">Humidity</span>
          <strong>{{ digest.weather.humidity }}%</strong>
        </div>

        <div>
          <span class="detail-label">Wind</span>
          <strong>{{ digest.weather.wind_speed_max }} km/h</strong>
        </div>

        <div>
          <span class="detail-label">Rain</span>
          <strong>{{ digest.weather.precipitation_sum }} mm</strong>
        </div>

        <div>
          <span class="detail-label">Sunrise</span>
          <strong>{{ digest.weather.sunrise }}</strong>
        </div>

        <div>
          <span class="detail-label">Sunset</span>
          <strong>{{ digest.weather.sunset }}</strong>
        </div>
      </div>
    </section>
    {% endif %}


      {# Prayer Times #}

      {% if digest.prayer_times %}
      <section class="digest-card prayer-card">
        <div class="section-heading">
          <h2>Prayer Times</h2>
        </div>

        <div class="prayer-grid">
          <div>
            <span>Fajr</span>
            <strong>{{ digest.prayer_times.fajr }}</strong>
          </div>

          <div>
            <span>Sunrise</span>
            <strong>{{ digest.prayer_times.sunrise }}</strong>
          </div>

          <div>
            <span>Dhuhr</span>
            <strong>{{ digest.prayer_times.dhuhr }}</strong>
          </div>

          <div>
            <span>Asr</span>
            <strong>{{ digest.prayer_times.asr }}</strong>
          </div>

          <div>
            <span>Maghrib</span>
            <strong>{{ digest.prayer_times.maghrib }}</strong>
          </div>

          <div>
            <span>Isha</span>
            <strong>{{ digest.prayer_times.isha }}</strong>
          </div>
        </div>
      </section>
      {% endif %}


      {# Gold + Silver #}

      {% if digest.commodities.gold or digest.commodities.silver %}
      <div class="digest-grid">

        {% if digest.commodities.gold %}
        <section class="digest-card">
          <div class="section-heading">
            <h2>Gold</h2>
            <span class="section-meta">{{ digest.commodities.gold.city }}</span>
          </div>

          <p class="large-value">
            Rs. {{ digest.commodities.gold.rate_24k_tola }}
          </p>
          <p class="value-label">24K per tola</p>

          <div class="metal-rates">
            <div>
              <span>22K</span>
              <strong>Rs. {{ digest.commodities.gold.rate_22k_tola }}</strong>
            </div>

            <div>
              <span>21K</span>
              <strong>Rs. {{ digest.commodities.gold.rate_21k_tola }}</strong>
            </div>
          </div>
        </section>
        {% endif %}


        {% if digest.commodities.silver %}
        <section class="digest-card">
          <div class="section-heading">
            <h2>Silver</h2>
            <span class="section-meta">{{ digest.commodities.silver.city }}</span>
          </div>

          <p class="large-value">
            Rs. {{ digest.commodities.silver.rate_tola }}
          </p>
          <p class="value-label">per tola</p>

          <p class="secondary-value">
            Rs. {{ digest.commodities.silver.rate_10g }}
            <span>per 10g</span>
          </p>
        </section>
        {% endif %}

      </div>
      {% endif %}


      {# Currencies + Fuel #}

      {% if digest.currencies or digest.fuel %}
      <div class="digest-grid">

        {% if digest.currencies %}
        <section class="digest-card">
          <div class="section-heading">
            <h2>Currencies</h2>
            <span class="section-meta">{{ digest.currencies.date | formatDate }}</span>
          </div>

          <div class="data-list">
            {% for code, rate in digest.currencies.rates %}
            <div class="data-row">
              <strong>{{ code }}</strong>
              <span>Rs. {{ rate }}</span>
            </div>
            {% endfor %}
          </div>
        </section>
        {% endif %}


        {% if digest.fuel %}
        <section class="digest-card">
          <div class="section-heading">
            <h2>Fuel</h2>
          </div>

          <div class="data-list">

            {% if digest.fuel.petrol %}
            <div class="data-row">
              <div>
                <strong>Petrol</strong>
                <span class="row-meta">
                  {{ digest.fuel.petrol.effective_date | formatDate }}
                </span>
              </div>

              <div class="row-value">
                <strong>Rs. {{ digest.fuel.petrol.price }}</strong>
                <span class="change">{{ digest.fuel.petrol.change }}</span>
              </div>
            </div>
            {% endif %}


            {% if digest.fuel.hsd %}
            <div class="data-row">
              <div>
                <strong>HSD</strong>
                <span class="row-meta">
                  {{ digest.fuel.hsd.effective_date | formatDate }}
                </span>
              </div>

              <div class="row-value">
                <strong>Rs. {{ digest.fuel.hsd.price }}</strong>
                <span class="change">{{ digest.fuel.hsd.change }}</span>
              </div>
            </div>
            {% endif %}

          </div>
        </section>
        {% endif %}

      </div>
      {% endif %}



      {# PSX #}

      {% if digest.psx %}
      <section class="digest-card">
        <div class="section-heading">
          <h2>PSX</h2>
          <span class="section-meta">{{ digest.psx.date | formatDate }}</span>
        </div>

        <div class="data-list">
          {% for symbol, stock in digest.psx.stocks %}
          <div class="stock-row">
            <div>
              <strong>{{ symbol }}</strong>
              <span class="row-meta">
                Vol. {{ stock.volume }}
              </span>
            </div>

            <div class="stock-price">
              <strong>Rs. {{ stock.close }}</strong>
              <span class="change">{{ stock.change_percent }}%</span>
            </div>
          </div>
          {% endfor %}
        </div>
      </section>
      {% endif %}


      {# Unavailable sections #}

      {% if digest.errors | length %}
      <section class="digest-card unavailable-card">
        <div class="section-heading">
          <h2>Unavailable</h2>
        </div>

        {% for section, message in digest.errors %}
        <p>
          <strong>{{ section | capitalize }}</strong>
          <span>{{ message }}</span>
        </p>
        {% endfor %}
      </section>
      {% endif %}

    </main>

    <footer>
      Daily Digest Archive
    </footer>

  </div>

</body>
</html>