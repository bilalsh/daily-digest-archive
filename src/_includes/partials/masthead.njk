{# Masthead. `backHref` and `subtitle` are set per page in front matter. #}
<header class="pt-10 pb-6">
  {% if backHref %}
  <a href="{{ backHref }}"
     class="mr-3 inline-block text-sm text-zinc-500 hover:text-teal-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-300">&lt; back-to-archive</a>
  {% endif %}

  <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-zinc-800 px-3 py-1 text-sm text-teal-300">
    <span class="relative flex size-2">
      <span class="absolute inline-flex size-full animate-ping rounded-full bg-teal-300 opacity-75 motion-reduce:hidden"></span>
      <span class="relative inline-flex size-2 rounded-full bg-teal-300"></span>
    </span>
    live · updated daily
  </p>

  <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">daily<span class="text-teal-300">_</span>digest.json</h1>

  {% if subtitle %}<p class="mt-2 text-sm text-zinc-500">{{ subtitle }}</p>{% endif %}
</header>
