{% import "macros/ui.njk" as ui %}

{% if digest.weather %}
{% set w = digest.weather %}
{% call ui.card("weather") %}

  <p class="mb-4 text-xs text-zinc-500"><span class="text-teal-400">//</span> weather.today()</p>

  <div class="flex flex-wrap items-center justify-between gap-5">
    <div>
      <div class="flex items-center gap-2">
        <span class="text-2xl leading-none">{{ w.summary | weatherIcon }}</span>
        <p class="text-base font-semibold">{{ w.summary }}</p>
      </div>
      <p class="mt-1 text-sm text-zinc-500">feels_like_max: {{ w.apparent_temperature_max }}°C</p>
    </div>

    <p class="text-4xl font-semibold text-teal-300 md:text-5xl">
      {{ w.temperature_max }}°<span class="text-xl font-medium text-zinc-500 md:text-2xl"> / {{ w.temperature_min }}°</span>
    </p>
  </div>

  <div class="mt-5 grid grid-cols-2 gap-4 border-t border-zinc-800 pt-4 sm:grid-cols-3 md:grid-cols-5">
    {% if w.significant_weather %}
      {{ ui.stat(w.significant_weather.type, w.significant_weather.period + " " + w.significant_weather.probability + "%") }}
    {% endif %}

    {{ ui.stat("humidity", w.humidity + "%") }}
    {{ ui.stat("wind", w.wind_speed_max + " km/h") }}
    {{ ui.stat("rain", w.precipitation_sum + " mm") }}

    {% if w.uv_index_max %}
      {{ ui.stat("uv index", w.uv_index_max, w.uv_category, w.uv_category | severityClass) }}
    {% endif %}

    {% if w.air_quality %}
      {{ ui.stat("air quality", w.air_quality.aqi, w.air_quality.category, w.air_quality.category | severityClass) }}
    {% endif %}

    {{ ui.stat("sunrise", w.sunrise) }}
    {{ ui.stat("sunset", w.sunset) }}
  </div>

{% endcall %}
{% endif %}
