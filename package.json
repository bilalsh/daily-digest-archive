{
  "name": "daily-digest",
  "version": "2.0.0",
  "private": true,
  "description": "Static archive of the daily Pakistan data digest, built with Eleventy and Tailwind CSS v4.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/style.css --minify",
    "build:site": "eleventy",
    "build": "npm run build:site && npm run build:css",
    "dev:css": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/style.css --watch",
    "dev:site": "eleventy --serve",
    "dev": "npm-run-all --parallel dev:css dev:site",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "npm-run-all": "^4.1.5"
  }
}
